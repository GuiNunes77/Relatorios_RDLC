                                            <Paragraphs>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value>Telefone . . . . . . . . . . . . . . . . . </Value>
                                                    <Style>
                                                      <FontFamily>Times New Roman</FontFamily>
                                                    </Style>
                                                  </TextRun>
                                                </TextRuns>
