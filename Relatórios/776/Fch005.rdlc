                                      <TablixCell>
                                        <CellContents>
                                          <Textbox Name="Textbox102">
                                            <KeepTogether>true</KeepTogether>
                                            <Paragraphs>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value>:  </Value>
                                                    <Style>
                                                      <FontFamily>Times New Roman</FontFamily>
                                                    </Style>
                                                  </TextRun>
                                                  <TextRun>
                                                    <Value>=IIf(IsNothing(Fields!DDD_FoneCel.Value),"",
"(" +Fields!DDD_FoneCel.Value+")") &amp;
IIf(IsNothing(Fields!Fone_Celular.Value),"",
Fields!Fone_Celular.Value)</Value>
                                                    <Style>
                                                      <FontFamily>Times New Roman</FontFamily>
                                                    </Style>
                                                  </TextRun>
                                                  <TextRun>
                                                    <Value xml:space="preserve"> </Value>
                                                    <Style>
                                                      <FontFamily>Times New Roman</FontFamily>
                                                    </Style>
                                                  </TextRun>
                                                  <TextRun>
                                                    <Value>=IIf(Not Isnothing(FIelds!DDD_FoneCel.Value) and Not IsNothing(Fields!Fone_Celular.Value) and
	(
		(Not IsNothing(Fields!DDD_FoneRes.Value) and Not IsNothing(Fields!Fone_Residencial.Value)) or 
		(Not IsNothing(FIelds!DDD_FoneTrab.Value) and Not IsNothing(Fields!Fone_Trabalho.Value))
	)
	, " / ", nothing)</Value>
                                                    <Style>
                                                      <FontFamily>Times New Roman</FontFamily>
                                                    </Style>
                                                  </TextRun>
                                                  <TextRun>
                                                    <Value xml:space="preserve"> </Value>
                                                    <Style>
                                                      <FontFamily>Times New Roman</FontFamily>
                                                    </Style>
                                                  </TextRun>
                                                  <TextRun>
                                                    <Value>=IIf(IsNothing(Fields!DDD_FoneRes.Value),"",
"(" +Fields!DDD_FoneRes.Value+")") &amp;
IIf(IsNothing(Fields!Fone_Residencial.Value),"",
Fields!Fone_Residencial.Value)</Value>
                                                    <Style>
                                                      <FontFamily>Times New Roman</FontFamily>
                                                    </Style>
                                                  </TextRun>
                                                  <TextRun>
                                                    <Value xml:space="preserve"> </Value>
                                                    <Style>
                                                      <FontFamily>Times New Roman</FontFamily>
                                                    </Style>
                                                  </TextRun>
                                                  <TextRun>
                                                    <Value>=IIf((Not IsNothing(Fields!DDD_FoneRes.Value) and Not IsNothing(Fields!Fone_Residencial.Value)) and
	(Not IsNothing(Fields!DDD_FoneTrab.Value) and Not IsNothing(Fields!Fone_Trabalho.Value)),
	" / ", "")</Value>
                                                    <Style>
                                                      <FontFamily>Times New Roman</FontFamily>
                                                    </Style>
                                                  </TextRun>
                                                  <TextRun>
                                                    <Value>=IIf(IsNothing(Fields!DDD_FoneTrab.Value),"",
"(" +Fields!DDD_FoneTrab.Value+")") &amp;
IIf(IsNothing(Fields!Fone_Trabalho.Value),"",
Fields!Fone_Trabalho.Value)</Value>
                                                    <Style>
                                                      <FontFamily>Times New Roman</FontFamily>
                                                    </Style>
                                                  </TextRun>
                                                </TextRuns>
