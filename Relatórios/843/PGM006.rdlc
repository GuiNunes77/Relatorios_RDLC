                                  <TextRuns>
                                    <TextRun>
                                      <Value>Eu, </Value>
                                      <Style />
                                    </TextRun>
                                    <TextRun>
                                      <Value>=Fields!NomeMedico.Value</Value>
                                      <Style />
                                    </TextRun>
                                    <TextRun>
                                      <Value> recebi da empresa </Value>
                                      <Style />
                                    </TextRun>
                                    <TextRun>
                                      <Value>=First(Fields!local_atendimento.Value, "Cabecalho")</Value>
                                      <Style />
                                    </TextRun>
                                    <TextRun>
                                      <Value> o valor de </Value>
                                      <Style />
                                    </TextRun>
                                    <TextRun>
                                      <Value>=Sum(Fields!ValorRecebido.Value) - 
(
	(Sum(Fields!ValorRecebido.Value * Fields!ValorPorcIRRF.Value) / 100) +
	(Sum(Fields!ValorRecebido.Value * Fields!ValorPorcCSLL.Value) / 100) +
	(Sum(Fields!ValorRecebido.Value * Fields!ValorPorcCONFINS.Value) / 100) +
	(Sum(Fields!ValorRecebido.Value * Fields!ValorPorcPIS.Value) / 100) +
	(Sum(Fields!ValorRecebido.Value * Fields!ValorPorcISS.Value) / 100) +
	(Sum(Fields!ValorRecebido.Value * Fields!ValorPorcCond.Value) / 100)
)</Value>
                                      <Style>
                                        <Format>'R$'#,0.00;('R$'#,0.00)</Format>
                                        <rd:FormatSymbolCulture>pt-BR</rd:FormatSymbolCulture>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value> em </Value>
                                      <Style>
                                        <Format>'R$'#,0.00;('R$'#,0.00)</Format>
                                        <rd:FormatSymbolCulture>pt-BR</rd:FormatSymbolCulture>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value>=Fields!DataPagamento.Value</Value>
                                      <Style>
                                        <Format>dd/MM/yyyy</Format>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style />
                                </Paragraph>
