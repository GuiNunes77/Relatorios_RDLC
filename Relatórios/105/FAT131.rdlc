                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox12">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(
    (IsNothing(Fields!DDD_FoneCel.Value) OR IsNothing(Fields!Fone_Celular.Value)) AND 
    (IsNothing(Fields!DDD_FoneRes.Value) OR IsNothing(Fields!Fone_Residencial.Value)), 
    Nothing,
    IIF(
        NOT IsNothing(Fields!DDD_FoneCel.Value) AND NOT IsNothing(Fields!Fone_Celular.Value) AND 
        NOT IsNothing(Fields!DDD_FoneRes.Value) AND NOT IsNothing(Fields!Fone_Residencial.Value),
        "(" &amp; CStr(Fields!DDD_FoneCel.Value) &amp; ") " &amp; CStr(Fields!Fone_Celular.Value) &amp; " / " &amp; 
        "(" &amp; CStr(Fields!DDD_FoneRes.Value) &amp; ") " &amp; CStr(Fields!Fone_Residencial.Value),
        IIF(
            NOT IsNothing(Fields!DDD_FoneCel.Value) AND NOT IsNothing(Fields!Fone_Celular.Value),
            "(" &amp; CStr(Fields!DDD_FoneCel.Value) &amp; ") " &amp; CStr(Fields!Fone_Celular.Value),
            "(" &amp; CStr(Fields!DDD_FoneRes.Value) &amp; ") " &amp; CStr(Fields!Fone_Residencial.Value)
        )
    )
)</Value>
                                  <Style>
                                    <FontFamily>Verdana</FontFamily>
                                    <FontSize>7pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Left</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox12</rd:DefaultName>
                          <Style>
