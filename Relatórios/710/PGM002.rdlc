                                  <Value>=Sum(Fields!ValorRecebido.Value + Fields!ValorFixo.Value) - 
(
	(Sum((Fields!ValorRecebido.Value + Fields!ValorFixo.Value) * Fields!ValorPorcIRRF.Value) / 100) +
	(Sum((Fields!ValorRecebido.Value + Fields!ValorFixo.Value) * Fields!ValorPorcCSLL.Value) / 100) +
	(Sum((Fields!ValorRecebido.Value + Fields!ValorFixo.Value) * Fields!ValorPorcCONFINS.Value) / 100) +
	(Sum((Fields!ValorRecebido.Value + Fields!ValorFixo.Value) * Fields!ValorPorcPIS.Value) / 100) +
	(Sum((Fields!ValorRecebido.Value + Fields!ValorFixo.Value) * Fields!ValorPorcISS.Value) / 100) +
	(Sum((Fields!ValorRecebido.Value + Fields!ValorFixo.Value) * Fields!ValorPorcCond.Value) / 100)
)</Value>
