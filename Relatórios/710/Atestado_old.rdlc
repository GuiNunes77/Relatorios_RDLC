          <Textbox Name="Textbox2">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Atesto que </Value>
                    <Style>
                      <FontFamily>Courier New</FontFamily>
                      <FontSize>16pt</FontSize>
                      <Color>#1f497d</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!Nome.Value, "Dados")</Value>
                    <Style>
                      <FontFamily>Courier New</FontFamily>
                      <FontSize>16pt</FontSize>
                      <Color>#1f497d</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> foi submetido(a) a procedimento </Value>
                    <Style>
                      <FontFamily>Courier New</FontFamily>
                      <FontSize>16pt</FontSize>
                      <Color>#1f497d</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!SOFTComplemento.Value, "Dados")</Value>
                    <Style>
                      <FontFamily>Courier New</FontFamily>
                      <FontSize>16pt</FontSize>
                      <Color>#1f497d</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>, devendo permanecer em repouso por </Value>
                    <Style>
                      <FontFamily>Courier New</FontFamily>
                      <FontSize>16pt</FontSize>
                      <Color>#1f497d</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Sum(Fields!DiasDispensa.Value, "Dados")</Value>
                    <Style>
                      <FontFamily>Courier New</FontFamily>
                      <FontSize>16pt</FontSize>
                      <Color>#1f497d</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> dia(s) a contar da data de hoje.</Value>
                    <Style>
                      <FontFamily>Courier New</FontFamily>
                      <FontSize>16pt</FontSize>
                      <Color>#1f497d</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>General</TextAlign>
                </Style>
