            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>RECIBO</Value>
                    <Style>
                      <FontStyle>Italic</FontStyle>
                      <FontFamily>Verdana</FontFamily>
                      <FontSize>20pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>None</TextDecoration>
