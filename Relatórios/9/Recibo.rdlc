  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="Textbox6">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="          Recebemos nesta data, do(a) Sr.(a) " + First(Fields!EmitirPara_Recibo.Value, "Dados") + 
	", portador(a) do CPF nº " + First(Fields!CPF_Favorecido_Recibo.Value, "Dados") + 
	", sob contato " + "(" + First(Fields!DDD_FoneCel.Value, "Dados") + ") " + First(Fields!Fone_Celular.Value, "Dados") +
	", residindo sob CEP: " +  First(Fields!CEP.Value, "Dados") + ", " + First(Fields!Endereco.Value, "Dados") + ", " + First(Fields!Bairro.Value, "Dados") + ", " + First(Fields!Cidade.Value, "Dados") + "/" + First(Fields!Estado.Value, "Dados") +
	", a importância de " + FormatCurrency(First(Fields!ValorEmitido.Value, "Dados"),2) +" ("+ LCase(First(Fields!ValorEmitidoExtenso.Value, "Dados")) + "), proveniente de exames realizados nesta Clínica de Diagnósticos."</Value>
                    <Style>
                      <FontFamily>Verdana</FontFamily>
                      <FontSize>12pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>General</TextAlign>
                  <LineHeight>9pt</LineHeight>
                </Style>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>Textbox6</rd:DefaultName>
            <Top>5cm</Top>
            <Left>0.5cm</Left>
            <Height>4cm</Height>
            <Width>15.9cm</Width>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <PaddingLeft>2pt</PaddingLeft>
              <PaddingRight>2pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
          </Textbox>
          <Textbox Name="SOFTComplemento">
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=First(Fields!SOFTComplemento.Value, "Dados")</Value>
                    <Style>
                      <FontFamily>Verdana</FontFamily>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>SOFTComplemento</rd:DefaultName>
            <Top>1.1cm</Top>
            <Left>0.1cm</Left>
            <Height>0.6cm</Height>
            <Width>16.7cm</Width>
            <ZIndex>1</ZIndex>
            <Style>
