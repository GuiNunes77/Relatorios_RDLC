                    <TablixCell>
                      <CellContents>
                        <Textbox Name="IRRF">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(Fields!TOTAL_PROCEDIMENTO.Value) * Fields!PORCIRRF.Value / 100</Value>
