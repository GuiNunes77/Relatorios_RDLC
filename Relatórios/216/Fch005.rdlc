            <Textbox Name="Textbox180">
              <KeepTogether>true</KeepTogether>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>Obs: Os exames estarão disponíveis durante 60 dias no nosso sistema, após isso, deverá ser solicitado com antecedência.</Value>
                      <Style>
                        <FontFamily>Verdana</FontFamily>
                        <FontSize>7pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                      </Style>
                    </TextRun>
