            <Textbox Name="Textbox148">
              <CanGrow>true</CanGrow>
              <KeepTogether>true</KeepTogether>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>-</Value>
                      <Style>
                        <FontFamily>Verdana</FontFamily>
                        <FontSize>6pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                      </Style>
                    </TextRun>
                    <TextRun>
                      <Value> Chegar com 15 min de antecedência para retirada, pois os exames serão impressos sob demanda, ou seja, impressão na hora, podendo demorar de 15 à 30 min!</Value>
                      <Style>
                        <FontFamily>Verdana</FontFamily>
                        <FontSize>7pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style>
                    <TextAlign>Left</TextAlign>
                  </Style>
                </Paragraph>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>RETIRADA DE EXAMES MEDIANTE APRESENTAÇÃO DO PROTOCOLO QUE FOI ENTREGUE OU DOCUMENTO!</Value>
                      <Style>
                        <FontFamily>Verdana</FontFamily>
                        <FontSize>8pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                        <TextDecoration>Underline</TextDecoration>
