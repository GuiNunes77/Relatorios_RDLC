  <Variables>
    <Variable Name="DDD_Res">
      <Value>=IIF(IsNothing(Fields!DDD_FoneRes.Value),
"(   ) ",
"(" + Fields!DDD_FoneRes.Value + ") ")</Value>
    </Variable>
    <Variable Name="Fone_Res">
      <Value>=IIF(IsNothing(Fields!Fone_Residencial.Value),
"",
Fields!Fone_Residencial.Value)</Value>
    </Variable>
    <Variable Name="DDD_Cel">
      <Value>=IIF(IsNothing(Fields!DDD_FoneCel.Value),
"(   ) ",
"(" + Fields!DDD_FoneCel.Value + ") ")</Value>
    </Variable>
    <Variable Name="Fone_Cel">
      <Value>=IIF(IsNothing(Fields!Fone_Celular.Value),
"",
Fields!Fone_Celular.Value)</Value>
    </Variable>
    <Variable Name="DDD_Tra">
      <Value>=IIF(IsNothing(Fields!DDD_FoneTrab.Value),
"(   ) ",
"(" + Fields!DDD_FoneTrab.Value + ") ")</Value>
    </Variable>
    <Variable Name="Fone_Tra">
      <Value>=IIF(IsNothing(Fields!Fone_Trabalho.Value),
"",
Fields!Fone_Trabalho.Value)</Value>
    </Variable>
    <Variable Name="ValidaTomo">
      <Value>=IIF(Lookup(13, Fields!teCodigo.Value, 1, "FichaAtendimento") = 1, false, true)</Value>
    </Variable>
    <Variable Name="ValidaRadio">
      <Value>=IIF(Lookup(11, Fields!teCodigo.Value, 1, "FichaAtendimento") = 1, false, true)</Value>
    </Variable>
    <Variable Name="ValidaAss">
      <Value>=IIF(Lookup(11, Fields!teCodigo.Value, 1, "FichaAtendimento") = 1 OrElse
   Lookup(13, Fields!teCodigo.Value, 2, "FichaAtendimento") = 2, false, true)</Value>
    </Variable>
  </Variables>
