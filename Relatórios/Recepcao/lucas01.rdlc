    <ReportSection>
      <Body>
        <ReportItems>
          <Rectangle Name="Rectangle5">
            <ReportItems>
              <Tablix Name="Tablix23">
                <TablixBody>
                  <TablixColumns>
                    <TablixColumn>
                      <Width>19.9cm</Width>
                    </TablixColumn>
                  </TablixColumns>
                  <TablixRows>
                    <TablixRow>
                      <Height>1.2cm</Height>
                      <TablixCells>
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="Textbox273">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>Autorizo a Única Clínica Médica de Diagnósticos por Imagem LTDA a colocar e processar meus dados pessoais com o propósito de Realização de Exames de Diagnostico por Imagem.</Value>
                                      <Style>
                                        <FontFamily>Verdana</FontFamily>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <rd:DefaultName>Textbox273</rd:DefaultName>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>2pt</PaddingRight>
                                <PaddingTop>2pt</PaddingTop>
                                <PaddingBottom>2pt</PaddingBottom>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                      </TablixCells>
                    </TablixRow>
                    <TablixRow>
                      <Height>0.7cm</Height>
                      <TablixCells>
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="Textbox279">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>Estou ciente que:</Value>
                                      <Style>
                                        <FontFamily>Verdana</FontFamily>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <rd:DefaultName>Textbox279</rd:DefaultName>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>2pt</PaddingRight>
                                <PaddingTop>2pt</PaddingTop>
                                <PaddingBottom>2pt</PaddingBottom>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                      </TablixCells>
                    </TablixRow>
                    <TablixRow>
                      <Height>2.9cm</Height>
                      <TablixCells>
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="Textbox280">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>&gt; Os dados coletados serão mantidos pelo período necessário para cumprir a finalizade acima ou retenção aproximado é de cinco anos.</Value>
                                      <Style>
                                        <FontFamily>Verdana</FontFamily>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <ListLevel>1</ListLevel>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>&gt; Os resultados do exame poderão ser compartilhados com profissionais de saúde envolvidos no meu atendimento, com o obijetivo de fornecer um diagnóstico adequado e o tratamento necessário.</Value>
                                      <Style>
                                        <FontFamily>Verdana</FontFamily>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <ListLevel>1</ListLevel>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>&gt; Posso revogar meu consentimento a qualquer momento, mediante solicitação por escrito à Clínica Única, sem prejuízo do tratamento realizado até o momento da revogação.</Value>
                                      <Style>
                                        <FontFamily>Verdana</FontFamily>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <ListLevel>1</ListLevel>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <rd:DefaultName>Textbox280</rd:DefaultName>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>2pt</PaddingRight>
                                <PaddingTop>2pt</PaddingTop>
                                <PaddingBottom>2pt</PaddingBottom>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                      </TablixCells>
                    </TablixRow>
                    <TablixRow>
