(
	(Sum(Fields!RecConv_ValorRecebido.Value * Fields!RecConv_PorcIRRF.Value) / 100) +
	(Sum(Fields!RecConv_ValorRecebido.Value * Fields!RecConv_PorcCOFINS.Value) / 100) +
	(Sum(Fields!RecConv_ValorRecebido.Value * Fields!RecConv_PorcPIS.Value) / 100) +
	(Sum(Fields!RecConv_ValorRecebido.Value * Fields!RecConv_PorcCSLL.Value) / 100) +
	(Sum(Fields!RecConv_ValorRecebido.Value * Fields!RecConv_PorcISS.Value) / 100) +
	(Sum(Fields!RecConv_ValorRecebido.Value * Fields!RecConv_PorcTaxas.Value) / 100)
)</Value>
