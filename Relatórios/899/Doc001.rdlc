                                                                        <TextDecoration>Underline</TextDecoration>
                                                                      </Style>
                                                                    </TextRun>
                                                                    <TextRun>
                                                                      <Value> Através do presente termo, o CONCORDANTE: </Value>
                                                                      <Style>
