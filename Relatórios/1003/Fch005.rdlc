                                          <Rectangle Name="Rectangle37">
                                            <ReportItems>
                                              <Tablix Name="Tablix32">
                                                <TablixBody>
                                                  <TablixColumns>
                                                    <TablixColumn>
                                                      <Width>19.18337cm</Width>
                                                    </TablixColumn>
                                                  </TablixColumns>
                                                  <TablixRows>
                                                    <TablixRow>
                                                      <Height>0.63952cm</Height>
                                                      <TablixCells>
                                                        <TablixCell>
                                                          <CellContents>
                                                            <Textbox Name="TituloExtra4">
                                                              <KeepTogether>true</KeepTogether>
                                                              <Paragraphs>
                                                                <Paragraph>
                                                                  <TextRuns>
                                                                    <TextRun>
                                                                      <Value>AUTORIZAÇÃO PARA RETIRADA DE EXAMES POR TERCEIROS</Value>
                                                                      <Style>
                                                                        <FontFamily>Times New Roman</FontFamily>
                                                                        <FontSize>11pt</FontSize>
                                                                      </Style>
                                                                    </TextRun>
                                                                  </TextRuns>
                                                                  <Style>
                                                                    <TextAlign>Center</TextAlign>
                                                                  </Style>
                                                                </Paragraph>
                                                              </Paragraphs>
                                                              <rd:DefaultName>TituloExtra</rd:DefaultName>
                                                              <ZIndex>1</ZIndex>
                                                              <Style>
                                                                <Border>
                                                                  <Style>None</Style>
                                                                </Border>
                                                                <PaddingLeft>2pt</PaddingLeft>
                                                                <PaddingRight>2pt</PaddingRight>
                                                                <PaddingTop>2pt</PaddingTop>
                                                                <PaddingBottom>2pt</PaddingBottom>
                                                              </Style>
                                                            </Textbox>
                                                          </CellContents>
                                                        </TablixCell>
                                                      </TablixCells>
                                                    </TablixRow>
                                                    <TablixRow>
                                                      <Height>0.63952cm</Height>
                                                      <TablixCells>
                                                        <TablixCell>
                                                          <CellContents>
                                                            <Textbox Name="TituloExtra3">
                                                              <KeepTogether>true</KeepTogether>
                                                              <Paragraphs>
                                                                <Paragraph>
                                                                  <TextRuns>
                                                                    <TextRun>
                                                                      <Value>(De acordo com os arts. 73 e 89 do Código de Ética Médica - Resolução CFM n° 2.217/2018)</Value>
                                                                      <Style>
                                                                        <FontFamily>Times New Roman</FontFamily>
                                                                        <FontSize>11pt</FontSize>
                                                                      </Style>
                                                                    </TextRun>
                                                                  </TextRuns>
                                                                  <Style>
                                                                    <TextAlign>Center</TextAlign>
                                                                  </Style>
                                                                </Paragraph>
                                                              </Paragraphs>
                                                              <rd:DefaultName>TituloExtra</rd:DefaultName>
                                                              <Style>
                                                                <Border>
                                                                  <Style>None</Style>
                                                                </Border>
                                                                <PaddingLeft>2pt</PaddingLeft>
                                                                <PaddingRight>2pt</PaddingRight>
                                                                <PaddingTop>2pt</PaddingTop>
                                                                <PaddingBottom>2pt</PaddingBottom>
                                                              </Style>
                                                            </Textbox>
                                                          </CellContents>
                                                        </TablixCell>
                                                      </TablixCells>
                                                    </TablixRow>
                                                    <TablixRow>
                                                      <Height>0.33952cm</Height>
                                                      <TablixCells>
                                                        <TablixCell>
                                                          <CellContents>
                                                            <Textbox Name="Textbox1306">
                                                              <KeepTogether>true</KeepTogether>
                                                              <Paragraphs>
                                                                <Paragraph>
                                                                  <TextRuns>
                                                                    <TextRun>
                                                                      <Value />
                                                                      <Style>
                                                                        <FontFamily>times New Roman</FontFamily>
                                                                        <FontWeight>Bold</FontWeight>
                                                                      </Style>
                                                                    </TextRun>
                                                                  </TextRuns>
                                                                  <Style>
                                                                    <TextAlign>Left</TextAlign>
                                                                  </Style>
                                                                </Paragraph>
                                                              </Paragraphs>
                                                              <rd:DefaultName>Textbox1306</rd:DefaultName>
                                                              <Style>
                                                                <Border>
                                                                  <Style>None</Style>
                                                                </Border>
                                                                <PaddingLeft>2pt</PaddingLeft>
                                                                <PaddingRight>2pt</PaddingRight>
                                                                <PaddingTop>2pt</PaddingTop>
                                                                <PaddingBottom>2pt</PaddingBottom>
                                                              </Style>
                                                            </Textbox>
                                                          </CellContents>
                                                        </TablixCell>
                                                      </TablixCells>
                                                    </TablixRow>
                                                    <TablixRow>
                                                      <Height>0.63952cm</Height>
                                                      <TablixCells>
                                                        <TablixCell>
                                                          <CellContents>
                                                            <Textbox Name="TituloExtra6">
                                                              <CanGrow>true</CanGrow>
                                                              <KeepTogether>true</KeepTogether>
                                                              <Paragraphs>
                                                                <Paragraph>
                                                                  <TextRuns>
                                                                    <TextRun>
                                                                      <Value xml:space="preserve">   </Value>
                                                                      <Style>
                                                                        <FontFamily>Times New Roman</FontFamily>
                                                                      </Style>
                                                                    </TextRun>
                                                                    <TextRun>
                                                                      <Value>Eu, </Value>
                                                                      <Style>
                                                                        <FontFamily>times New Roman</FontFamily>
                                                                      </Style>
                                                                    </TextRun>
                                                                    <TextRun>
                                                                      <Value>=First(Fields!Nome.Value, "FichaAtendimento")</Value>
                                                                      <Style>
                                                                        <FontFamily>times New Roman</FontFamily>
                                                                      </Style>
                                                                    </TextRun>
                                                                    <TextRun>
                                                                      <Value xml:space="preserve"> </Value>
                                                                      <Style>
                                                                        <FontFamily>times New Roman</FontFamily>
                                                                      </Style>
                                                                    </TextRun>
                                                                    <TextRun>
                                                                      <Value>AUTORIZO a CLÍNICA DE ULTRA-SONOGRAFIA SOCIEDADE LTDA, a compartilhar com à empresa ou o(a) Médico(a) solicitante do exame, o resultado.</Value>
                                                                      <Style>
                                                                        <FontFamily>Times New Roman</FontFamily>
                                                                      </Style>
                                                                    </TextRun>
                                                                  </TextRuns>
                                                                  <Style>
                                                                    <TextAlign>Left</TextAlign>
                                                                  </Style>
                                                                </Paragraph>
                                                                <Paragraph>
                                                                  <TextRuns>
                                                                    <TextRun>
                                                                      <Value>   Compreendo que esta autorização é necessário para garantir o cumprimento da LGPD e que os dados compartilhados serão utilizados somente para fins indicados acima, sendo a proibição sua utilização para outros propósitos sem meu consentimento expresso.</Value>
                                                                      <Style>
                                                                        <FontFamily>Times New Roman</FontFamily>
                                                                      </Style>
                                                                    </TextRun>
                                                                  </TextRuns>
                                                                  <Style>
                                                                    <TextAlign>Left</TextAlign>
                                                                  </Style>
                                                                </Paragraph>
                                                                <Paragraph>
                                                                  <TextRuns>
                                                                    <TextRun>
                                                                      <Value />
                                                                      <Style>
                                                                        <FontFamily>Times New Roman</FontFamily>
                                                                      </Style>
                                                                    </TextRun>
                                                                  </TextRuns>
                                                                  <Style>
                                                                    <TextAlign>Left</TextAlign>
                                                                  </Style>
                                                                </Paragraph>
                                                                <Paragraph>
                                                                  <TextRuns>
                                                                    <TextRun>
                                                                      <Value>   Declaro estar ciente de que:</Value>
                                                                      <Style>
                                                                        <FontFamily>Times New Roman</FontFamily>
                                                                      </Style>
                                                                    </TextRun>
                                                                  </TextRuns>
                                                                  <Style>
                                                                    <TextAlign>Left</TextAlign>
                                                                  </Style>
                                                                </Paragraph>
                                                                <Paragraph>
                                                                  <TextRuns>
                                                                    <TextRun>
                                                                      <Value>   I - Posso revogar esse consentimento a qualquer momento, mediante solicitação escrita enviada para o email </Value>
                                                                      <Style>
                                                                        <FontFamily>Times New Roman</FontFamily>
                                                                      </Style>
                                                                    </TextRun>
                                                                    <TextRun>
                                                                      <Value>medimagem@medimagem.med.br</Value>
                                                                      <Style>
                                                                        <FontFamily>Times New Roman</FontFamily>
                                                                        <TextDecoration>Underline</TextDecoration>
                                                                      </Style>
                                                                    </TextRun>
                                                                  </TextRuns>
                                                                  <Style>
                                                                    <TextAlign>Left</TextAlign>
                                                                  </Style>
                                                                </Paragraph>
                                                                <Paragraph>
                                                                  <TextRuns>
                                                                    <TextRun>
                                                                      <Value>   II - Tenho direito de solicitar informações sobre o tratamento de meus dados pessoais, e que a Med Imagem está comprometida em manter a confidencialidade e segurança das informações fornecidas.</Value>
                                                                      <Style>
                                                                        <FontFamily>Times New Roman</FontFamily>
                                                                      </Style>
                                                                    </TextRun>
                                                                  </TextRuns>
                                                                  <Style>
                                                                    <TextAlign>Left</TextAlign>
                                                                  </Style>
                                                                </Paragraph>
                                                              </Paragraphs>
                                                              <rd:DefaultName>TituloExtra</rd:DefaultName>
                                                              <ZIndex>2</ZIndex>
                                                              <Style>
                                                                <Border>
                                                                  <Style>None</Style>
                                                                </Border>
                                                                <PaddingLeft>2pt</PaddingLeft>
                                                                <PaddingRight>2pt</PaddingRight>
                                                                <PaddingTop>2pt</PaddingTop>
                                                                <PaddingBottom>2pt</PaddingBottom>
                                                              </Style>
                                                            </Textbox>
                                                          </CellContents>
                                                        </TablixCell>
                                                      </TablixCells>
                                                    </TablixRow>
                                                    <TablixRow>
                                                      <Height>0.69285cm</Height>
