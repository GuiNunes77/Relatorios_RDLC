                                      <TablixMember />
                                      <TablixMember>
                                        <Visibility>
                                          <Hidden>=
iif( 
	(sum(
		Switch(
			max(Fields!teCodigo.Value, "teCodigo") = 10, 1,
			max(Fields!teCodigo.Value, "teCodigo") = 11, 1,
			max(Fields!teCodigo.Value, "teCodigo") = 13, 1,
			max(Fields!teCodigo.Value, "teCodigo") = 16, 1,
			max(Fields!teCodigo.Value, "teCodigo") = 17, 1,
			1=1, 0)
	) &gt; 0)
	AND
	(Fields!Sexo.Value = "F")
	AND
	(
	(DateDiff(DateInterval.DAY, Fields!DataNasc.Value,Fields!Data.Value)\365 &gt;= 12) and
	(DateDiff(DateInterval.DAY, Fields!DataNasc.Value, Fields!Data.Value)\365 &lt; 46)
	)
,
false,true
)</Hidden>
                                        </Visibility>
