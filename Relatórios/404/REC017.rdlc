                              <TextRuns>
                                <TextRun>
                                  <Value>=(Sum(IIF(Fields!TIPO.Value = "F",
CSng(FormatNumber(Fields!TOTAL_PROCEDIMENTO.Value,2)),
0
)) - 
(
	(CSng(FormatNumber(Sum(IIF(IsNothing(Fields!seq_Fatura.Value),0,Fields!TOTAL_PROCEDIMENTO.Value) * Fields!PorcIRRF.Value) / 100,2))) +
	(CSng(FormatNumber(Sum(IIF(IsNothing(Fields!seq_Fatura.Value),0,Fields!TOTAL_PROCEDIMENTO.Value) * Fields!PorcCSLL.Value) / 100,2))) +
	(CSng(FormatNumber(Sum(IIF(IsNothing(Fields!seq_Fatura.Value),0,Fields!TOTAL_PROCEDIMENTO.Value) * Fields!PorcCOFINS.Value) / 100,2))) +
	(CSng(FormatNumber(Sum(IIF(IsNothing(Fields!seq_Fatura.Value),0,Fields!TOTAL_PROCEDIMENTO.Value) * Fields!PorcPIS.Value) / 100,2))) +
	(CSng(FormatNumber(Sum(IIF(IsNothing(Fields!seq_Fatura.Value),0,Fields!TOTAL_PROCEDIMENTO.Value) * Fields!PorcISS.Value) / 100,2))) +
	(CSng(FormatNumber(Sum(IIF(IsNothing(Fields!seq_Fatura.Value),0,Fields!TOTAL_PROCEDIMENTO.Value) * Fields!PorcTAXA.Value) / 100,2)))
))
-
(Sum(IIF(Fields!TIPO.Value = "R",
CSng(FormatNumber(Fields!VALORRECEBIDO.Value,2)),
0
)) -
(
	(CSng(FormatNumber(Sum(IIF(IsNothing(Fields!seq_Receb.Value),0,Fields!VALORRECEBIDO.Value) * Fields!PorcIRRF.Value) / 100,2))) +
	(CSng(FormatNumber(Sum(IIF(IsNothing(Fields!seq_Receb.Value),0,Fields!VALORRECEBIDO.Value) * Fields!PorcCSLL.Value) / 100,2))) +
	(CSng(FormatNumber(Sum(IIF(IsNothing(Fields!seq_Receb.Value),0,Fields!VALORRECEBIDO.Value) * Fields!PorcCOFINS.Value) / 100,2))) +
	(CSng(FormatNumber(Sum(IIF(IsNothing(Fields!seq_Receb.Value),0,Fields!VALORRECEBIDO.Value) * Fields!PorcPIS.Value) / 100,2))) +
	(CSng(FormatNumber(Sum(IIF(IsNothing(Fields!seq_Receb.Value),0,Fields!VALORRECEBIDO.Value) * Fields!PorcISS.Value) / 100,2))) +
	(CSng(FormatNumber(Sum(IIF(IsNothing(Fields!seq_Receb.Value),0,Fields!VALORRECEBIDO.Value) * Fields!PorcTAXA.Value) / 100,2)))
))</Value>
                                  <Style>
