                            <Textbox Name="Textbox54">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value xml:space="preserve"> </Value>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value>=IIf(IsNothing(Fields!DDD_FoneCel.Value), "", "(" + Fields!DDD_FoneCel.Value + ")") &amp; IIf(IsNothing(Fields!Fone_Celular.Value), "", Fields!Fone_Celular.Value)</Value>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value xml:space="preserve"> </Value>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value>=IIf(Not Isnothing(Fields!DDD_FoneCel.Value) And Not IsNothing(Fields!Fone_Celular.Value) And ((Not IsNothing(Fields!DDD_FoneRes.Value) And Not IsNothing(Fields!Fone_Residencial.Value)) Or (Not IsNothing(Fields!DDD_FoneTrab.Value) And Not IsNothing(Fields!Fone_Trabalho.Value))), " / ", Nothing)</Value>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value xml:space="preserve"> </Value>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value>=IIf(IsNothing(Fields!DDD_FoneRes.Value), "", "(" + Fields!DDD_FoneRes.Value + ")") &amp; IIf(IsNothing(Fields!Fone_Residencial.Value), "", Fields!Fone_Residencial.Value)</Value>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value xml:space="preserve"> </Value>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value>=IIf((Not IsNothing(Fields!DDD_FoneRes.Value) And Not IsNothing(Fields!Fone_Residencial.Value)) And (Not IsNothing(Fields!DDD_FoneTrab.Value) And Not IsNothing(Fields!Fone_Trabalho.Value)), " / ", "")</Value>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value>=IIf(IsNothing(Fields!DDD_FoneTrab.Value), "", "(" + Fields!DDD_FoneTrab.Value + ")") &amp; IIf(IsNothing(Fields!Fone_Trabalho.Value), "", Fields!Fone_Trabalho.Value)</Value>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
