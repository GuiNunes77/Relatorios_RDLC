              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Paciente: </Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>14pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!Nome.Value, "Dados")</Value>
