                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Switch(
Fields!CODIGO_PROCED_FATURA.Value = "1",  "Ultrassonografia pélvica",
Fields!CODIGO_PROCED_FATURA.Value = "2",  "Ultrassonografia transvaginal",
Fields!CODIGO_PROCED_FATURA.Value = "3",  "US obstétrica com doppler colorido",
Fields!CODIGO_PROCED_FATURA.Value = "4",  "Ultrassonografia obstétrica",
Fields!CODIGO_PROCED_FATURA.Value = "5",  "Ultrassonografia morfológica",
Fields!CODIGO_PROCED_FATURA.Value = "6",  "Ultrassonografia morfológica com Doppler colorido",
Fields!CODIGO_PROCED_FATURA.Value = "7",  "Ultrassonografia de mamas",
Fields!CODIGO_PROCED_FATURA.Value = "8",  "Ultrassonografia de Membros Superiores",
Fields!CODIGO_PROCED_FATURA.Value = "9",  "Ultrassonografia de Membros Inferiores",
Fields!CODIGO_PROCED_FATURA.Value = "10", "Ultrassonografia de Parede Abdominal",
Fields!CODIGO_PROCED_FATURA.Value = "11", "Ultrassonografia de Doppler arterial (unilateral)",
Fields!CODIGO_PROCED_FATURA.Value = "12", "Ultrassonografia renal com doppler colorido",
Fields!CODIGO_PROCED_FATURA.Value = "13", "Ultrassonografia de abdome superior vias biliares",
Fields!CODIGO_PROCED_FATURA.Value = "14", "Ultrassonografia de abdome inferior",
Fields!CODIGO_PROCED_FATURA.Value = "15", "Ultrassonografia de abdome total",
Fields!CODIGO_PROCED_FATURA.Value = "16", "Ultrassonografia de próstata abdominal",
Fields!CODIGO_PROCED_FATURA.Value = "17", "Ultrassonografia de próstata transretal",
Fields!CODIGO_PROCED_FATURA.Value = "18", "Ultrassonografia próstata transretal com biopsia",
Fields!CODIGO_PROCED_FATURA.Value = "19", "Ultrassonografia do aparelho urinario (rins,bexiga)",
Fields!CODIGO_PROCED_FATURA.Value = "20", "Ultrassonografia de tireoide",
Fields!CODIGO_PROCED_FATURA.Value = "21", "Ultrassonografia de bolsa escrotal – testículos",
Fields!CODIGO_PROCED_FATURA.Value = "22", "Ultrassonografia de pele anexos",
Fields!CODIGO_PROCED_FATURA.Value = "23", "Ultrassonografia músculo esquelético (partes moles, região inguinal, cervical)",
Fields!CODIGO_PROCED_FATURA.Value = "24", "Ultrassonografia arterial membros inferiores com Doppler",
Fields!CODIGO_PROCED_FATURA.Value = "25", "Ultrassonografia venoso membros inferiores com Doppler",
Fields!CODIGO_PROCED_FATURA.Value = "26", "Ultrassonografia arterial membros superiores com Doppler",
Fields!CODIGO_PROCED_FATURA.Value = "27", "Ultrassonografia venoso membros superiores com Doppler",
Fields!CODIGO_PROCED_FATURA.Value = "28", "Ultrassonografia carotida",
Fields!CODIGO_PROCED_FATURA.Value = "29", "Ultrassonografia Doppler Colorido de Órgãos e Estruturas",
Fields!CODIGO_PROCED_FATURA.Value = "30", "Ultrassonografia Transvaginal Obstétrico 1 à 3 meses (5 à 13 sem)",
Fields!CODIGO_PROCED_FATURA.Value = "31", "Radiografia de abdome simples",
Fields!CODIGO_PROCED_FATURA.Value = "32", "Radiografia de articulações coxo femoral (cada lado)",
Fields!CODIGO_PROCED_FATURA.Value = "33", "Radiografia de articulações em membros inferiores",
Fields!CODIGO_PROCED_FATURA.Value = "34", "Radiografia de articulações em membros superiores",
Fields!CODIGO_PROCED_FATURA.Value = "35", "Radiografia de bacia",
Fields!CODIGO_PROCED_FATURA.Value = "36", "Radiografia de cavum ou adenoide - lateral",
Fields!CODIGO_PROCED_FATURA.Value = "37", "Radiografia de cóccix",
Fields!CODIGO_PROCED_FATURA.Value = "38", "Radiografia de coluna dorsal ",
Fields!CODIGO_PROCED_FATURA.Value = "39", "Radiografia de coluna cervical",
Fields!CODIGO_PROCED_FATURA.Value = "40", "Radiografia de coluna lombar",
Fields!CODIGO_PROCED_FATURA.Value = "41", "Coluna total para escoliose",
Fields!CODIGO_PROCED_FATURA.Value = "42", "Radiografia de costelas (hemitorax)",
Fields!CODIGO_PROCED_FATURA.Value = "43", "Radiografia - Escanometria",
Fields!CODIGO_PROCED_FATURA.Value = "44", "Radiografia de mãos e punhos para idade óssea",
Fields!CODIGO_PROCED_FATURA.Value = "45", "Radiografia panorâmica de membros inferiores",
Fields!CODIGO_PROCED_FATURA.Value = "46", "Radiografia de seios da face: f.n + mn + Lateral",
