Fields!CODIGO_PROCED_FATURA.Value = "48", "Radiografia de tórax P.A. + Lateral + Obliqua",
Fields!CODIGO_PROCED_FATURA.Value = "49", "Radiografia - Densitometria óssea (coluna e fêmur)",
Fields!CODIGO_PROCED_FATURA.Value = "50", "Radiografia de enema opaco",
Fields!CODIGO_PROCED_FATURA.Value = "51", "Radiografia de esôfago,hiato, estomago e duodeno",
