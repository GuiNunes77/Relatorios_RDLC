                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(CountDistinct(Fields!SEQUENCIA.Value, "grpAMB") * Max(Fields!TOTAL_PROCEDIMENTO.Value, "grpAMB"))</Value>
                                  <Style>
                                    <FontFamily>Verdana</FontFamily>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
