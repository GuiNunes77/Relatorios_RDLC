                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(IIF(Month(Fields!MESREFERENCIA.Value) = 1,
Fields!TOTAL_PROCEDIMENTO.Value,
Nothing
)) + 0</Value>
                                  <Style>
                                    <FontFamily>Verdana</FontFamily>
                                    <FontSize>8pt</FontSize>
