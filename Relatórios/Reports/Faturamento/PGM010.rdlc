                    <TablixCell>
                      <CellContents>
                        <Textbox Name="tbxTotalLiquido2">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(Fields!ValorRecebido.Value) - 
(
	(Sum(Fields!ValorRecebido.Value * Fields!ValorPorcIRRF.Value) / 100) +
	(Sum(Fields!ValorRecebido.Value * Fields!ValorPorcCSLL.Value) / 100) +
	(Sum(Fields!ValorRecebido.Value * Fields!ValorPorcCONFINS.Value) / 100) +
	(Sum(Fields!ValorRecebido.Value * Fields!ValorPorcPIS.Value) / 100) +
	(Sum(Fields!ValorRecebido.Value * Fields!ValorPorcISS.Value) / 100) +
	(Sum(Fields!ValorRecebido.Value * Fields!ValorPorcCBS.Value) / 100) +
	(Sum(Fields!ValorRecebido.Value * Fields!ValorPorcIBS.Value) / 100) +
	(Sum(Fields!ValorRecebido.Value * Fields!ValorPorcCond.Value) / 100)
)</Value>
                                  <Style>
                                    <FontFamily>Verdana</FontFamily>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>0.00;(0.00)</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <TopBorder>
                              <Style>Solid</Style>
                            </TopBorder>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
