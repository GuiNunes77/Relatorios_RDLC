                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(Fields!VALORRECEBIDO.Value) - 
(
	(Sum(Fields!VALORRECEBIDO.Value * Fields!PorcIRRF.Value) / 100) +
	(Sum(Fields!VALORRECEBIDO.Value * Fields!PorcCSLL.Value) / 100) +
	(Sum(Fields!VALORRECEBIDO.Value * Fields!PorcCOFINS.Value) / 100) +
	(Sum(Fields!VALORRECEBIDO.Value * Fields!PorcPIS.Value) / 100) +
	(Sum(Fields!VALORRECEBIDO.Value * Fields!PorcISS.Value) / 100) +
	(Sum(Fields!VALORRECEBIDO.Value * Fields!PorcCBS.Value) / 100) +
	(Sum(Fields!VALORRECEBIDO.Value * Fields!PorcIBS.Value) / 100) +
	(Sum(Fields!VALORRECEBIDO.Value * Fields!PorcTAXA.Value) / 100)
)</Value>
                                  <Style>
                                    <FontFamily>Verdana</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>0.00;(0.00)</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
