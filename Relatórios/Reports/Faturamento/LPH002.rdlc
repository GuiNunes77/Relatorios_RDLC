                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(Iif(isNothing(Fields!VCHO.Value),
	0,
	Fields!VCHO.Value)
	+
    Iif(isNothing(Fields!VCHM.Value),
	0,
	Fields!VCHM.Value)
	+
    Iif(isNothing(Fields!VFILME.Value),
	0,
	Fields!VFILME.Value)
)</Value>
                                  <Style>
                                    <FontFamily>Verdana</FontFamily>
                                    <FontSize>7pt</FontSize>
                                    <Format>#,0.00;(#,0.00)</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
