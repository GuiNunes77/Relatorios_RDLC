                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox12">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF
(
	IIF
	(
		DateDiff("d", CDate(MID(Parameters!periodo.Value,1,10)), CDate(MID(Parameters!periodo.Value,14,10))) / 30 = 0,
		SUM(IIF(Fields!TIPO.Value = 0,0, Fields!QTDE.Value)),
		SUM(IIF(Fields!TIPO.Value = 0,0, Fields!QTDE.Value)) / (DateDiff("d", CDate(MID(Parameters!periodo.Value,1,10)), CDate(MID(Parameters!periodo.Value,14,10))) / 30)
	) &lt; Fields!ESTOQUE.Value,
	0,
	IIF
	(
		DateDiff("d", CDate(MID(Parameters!periodo.Value,1,10)), CDate(MID(Parameters!periodo.Value,14,10))) / 30 = 0,
		SUM(IIF(Fields!TIPO.Value = 0,0, Fields!QTDE.Value)),
		SUM(IIF(Fields!TIPO.Value = 0,0, Fields!QTDE.Value)) / (DateDiff("d", CDate(MID(Parameters!periodo.Value,1,10)), CDate(MID(Parameters!periodo.Value,14,10))) / 30)
	) - Fields!ESTOQUE.Value
)</Value>
                                  <Style>
                                    <FontFamily>VERDAna</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <Format>0.00;(0.00)</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
