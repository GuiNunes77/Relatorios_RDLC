                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Porcentagem2">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Iif(Sum(CDbl(Fields!Realizado.Value)) &lt;&gt; 0 and Sum(CDbl(Fields!PrevisaoValorMedico.Value)) &lt;&gt; 0,
	(Sum(CDbl(Fields!PrevisaoValorMedico.Value)) 
		/ 
	 Sum(CDbl(Fields!Realizado.Value))) * CDbl(100),
	 CDbl(0))</Value>
                                  <Style>
                                    <FontFamily>Verdana</FontFamily>
                                    <FontSize>7pt</FontSize>
                                    <Format>#,0.00;(#,0.00)</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
