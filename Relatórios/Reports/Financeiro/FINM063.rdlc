                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(Fields!Codigo.Value = Nothing OR Trim(Fields!Codigo.Value) = "", Nothing, Fields!Codigo.Value + " - ")
+
Fields!DescricaoDocto.Value</Value>
                                  <Style>
                                    <FontFamily>Verdana</FontFamily>
                                    <FontSize>6pt</FontSize>
                                    <FontWeight>=IIF(Fields!Nivel.Value &lt;= 3, "Bold", "Default")</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
