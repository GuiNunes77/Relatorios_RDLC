                            </RightBorder>
                            <BackgroundColor>=IIF(Fields!Nivel.Value = 2, "Gainsboro", "Transparent")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>=IIF(Fields!Nivel.Value = 2, "1pt",
IIF(Fields!Nivel.Value = 3, "6pt",
IIF(Fields!Nivel.Value = 4, "11pt",
IIF(Fields!Nivel.Value = 5, "16pt",
IIF(Fields!Nivel.Value = 6, "21pt",
IIF(Fields!Nivel.Value = 7, "26pt",
IIF(Fields!Nivel.Value = 8, "31pt",
IIF(Fields!Nivel.Value = 9, "36pt",
IIF(Fields!Nivel.Value = 10, "41pt",
"1pt")))))))))</PaddingLeft>
                            <PaddingRight>1pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
