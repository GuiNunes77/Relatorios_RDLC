                    <Textbox Name="Textbox35">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=IIF(Fields!FisicaJuridica.Value = "J" and IsNothing(Fields!Observacao.Value) or Fields!Observacao.Value = "",
"     Recebemos nesta data, do(a) Sr.(a) " + Fields!NomeFavorecido.Value + ", portador(a) do IE nº " + Fields!IE_RG.Value + " e CNPJ nº " + Fields!CNPJ_CPF.Value + ", a importância de " + RTrim(Fields!ValorPorExtenso.Value) + ".",
IIF(Fields!FisicaJuridica.Value = "F" and IsNothing(Fields!Observacao.Value) or Fields!Observacao.Value = "",
"     Recebemos nesta data, do(a) Sr.(a) " + Fields!NomeFavorecido.Value + ", portador(a) do RG nº " + Fields!IE_RG.Value + " e CPF nº " + Fields!CNPJ_CPF.Value + ", a importância de " + RTrim(Fields!ValorPorExtenso.Value) + ".",
IIF(Fields!FisicaJuridica.Value = "J" = Not IsNothing(Fields!Observacao.Value) or Fields!Observacao.Value &lt;&gt; "",
"     Recebemos nesta data, do(a) Sr.(a) " + Fields!NomeFavorecido.Value + ", portador(a) do IE nº " + Fields!IE_RG.Value + " e CNPJ nº " + Fields!CNPJ_CPF.Value + ", a importância de " + RTrim(Fields!ValorPorExtenso.Value) + ", proveniente de " + Fields!Observacao.Value + ".",
"     Recebemos nesta data, do(a) Sr.(a) " + Fields!NomeFavorecido.Value + ", portador(a) do RG nº " + Fields!IE_RG.Value + " e CPF nº " + Fields!CNPJ_CPF.Value + ", a importância de " + RTrim(Fields!ValorPorExtenso.Value) + ", proveniente de " + Fields!Observacao.Value + "."
)))</Value>
                              <Style>
                                <FontFamily>verdana</FontFamily>
                                <FontSize>14pt</FontSize>
                              </Style>
                            </TextRun>
                          </TextRuns>
