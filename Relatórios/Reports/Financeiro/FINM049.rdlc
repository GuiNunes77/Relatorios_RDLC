                    <TablixCell>
                      <CellContents>
                        <Textbox Name="VALOR_CALC4">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=SUM(IIF(Month(Fields!DATAVENCIMENTO.Value) = 1 AND Fields!GRUPO_CLASSIFIC.Value = 1, (Fields!CREDITO.Value - Fields!DEBITO.Value), NOTHING)) + 0 -
SUM(IIF(Month(Fields!DATAVENCIMENTO.Value) = 1 AND Fields!GRUPO_CLASSIFIC.Value = 2, (Fields!DEBITO.Value - Fields!CREDITO.Value), NOTHING)) + 0 -
SUM(IIF(Month(Fields!DATAVENCIMENTO.Value) = 1 AND Fields!GRUPO_CLASSIFIC.Value = 3, (Fields!DEBITO.Value - Fields!CREDITO.Value), NOTHING)) + 0 -
SUM(IIF(Month(Fields!DATAVENCIMENTO.Value) = 1 AND Fields!GRUPO_CLASSIFIC.Value = 4, (Fields!DEBITO.Value - Fields!CREDITO.Value), NOTHING)) + 0</Value>
                                  <Style>
                                    <FontFamily>verdana</FontFamily>
                                    <FontSize>6pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>#,0.00;(#,0.00)</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Style>Solid</Style>
                            </Border>
                            <TopBorder>
