                              <TextRuns>
                                <TextRun>
                                  <Value>=SUM(IIF(Fields!GRUPO_CLASSIFIC.Value = 1, (Fields!CREDITO.Value - Fields!DEBITO.Value), NOTHING)) + 0 -
SUM(IIF(Fields!GRUPO_CLASSIFIC.Value = 2, (Fields!DEBITO.Value - Fields!CREDITO.Value), NOTHING)) + 0 -
SUM(IIF(Fields!GRUPO_CLASSIFIC.Value = 3, (Fields!DEBITO.Value - Fields!CREDITO.Value), NOTHING)) + 0 -
SUM(IIF(Fields!GRUPO_CLASSIFIC.Value = 4, (Fields!DEBITO.Value - Fields!CREDITO.Value), NOTHING)) + 0</Value>
                                  <Style>
                                    <FontFamily>verdana</FontFamily>
                                    <FontSize>6pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>'R$'#,0.00;('R$'#,0.00)</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
