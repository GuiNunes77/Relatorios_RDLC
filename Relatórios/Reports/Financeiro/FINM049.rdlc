                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(ReportItems!ReceitaTotal.Value = 0, "-  ", 
(
SUM(IIF(Fields!GRUPO_CLASSIFIC.Value = 1, (Fields!CREDITO.Value - Fields!DEBITO.Value), NOTHING)) + 0 -
SUM(IIF(Fields!GRUPO_CLASSIFIC.Value = 2, (Fields!DEBITO.Value - Fields!CREDITO.Value), NOTHING)) + 0
) / (IIF(ReportItems!ReceitaTotal.Value = 0, 1, ReportItems!ReceitaTotal.Value)))</Value>
                                  <Style>
