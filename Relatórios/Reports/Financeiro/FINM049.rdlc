                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(IIF(Month(Fields!DATAVENCIMENTO.Value) = 1, (Fields!DEBITO.Value - Fields!CREDITO.Value), Nothing)) + 0</Value>
