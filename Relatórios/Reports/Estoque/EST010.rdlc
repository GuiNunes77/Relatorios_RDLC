                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF
(
	Sum(IIf(Fields!TIPO.Value = "1", Fields!QTDE.Value, 0)) / (DateDiff("M", CDate(MID(Parameters!periodo.Value,1,10)), CDate(MID(Parameters!periodo.Value,14,10))) + 1) + IIF(IsNothing(Fields!ESTMINIMO.Value),0,Fields!ESTMINIMO.Value) &lt; IIF(IsNothing(Fields!ESTOQUE.Value),0,Fields!ESTOQUE.Value),
	0,
	Sum(IIf(Fields!TIPO.Value = "1", Fields!QTDE.Value, 0)) / (DateDiff("M", CDate(MID(Parameters!periodo.Value,1,10)), CDate(MID(Parameters!periodo.Value,14,10))) + 1) + IIF(IsNothing(Fields!ESTMINIMO.Value),0,Fields!ESTMINIMO.Value) - IIF(IsNothing(Fields!ESTOQUE.Value),0,Fields!ESTOQUE.Value)
)</Value>
                                  <Style>
                                    <FontFamily>Verdana</FontFamily>
                                    <FontSize>7pt</FontSize>
                                    <Format>0.00;(0.00)</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
