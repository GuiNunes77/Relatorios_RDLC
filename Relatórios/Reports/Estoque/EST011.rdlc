    Sum(IIf(Fields!TIPO.Value = "1", Fields!QTDE.Value, 0)) / (DateDiff("d", CDate(MID(Parameters!periodo.Value,1,10)), CDate(MID(Parameters!periodo.Value,14,10))) / 30)
