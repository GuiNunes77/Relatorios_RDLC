                      <CellContents>
                        <Textbox Name="SALDO_ANTERIOR">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!ESTOQUE.Value -
(
	Sum(IIf(Fields!TIPO.Value = "0", Fields!QTDE.Value, 0)) -
	Sum(IIf(Fields!TIPO.Value = "1", Fields!QTDE.Value, 0))
)</Value>
                                  <Style>
                                    <FontFamily>Verdana</FontFamily>
